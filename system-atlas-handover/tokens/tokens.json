{
  "$description": "System Atlas design tokens. Source of truth for color, type, spacing, motion and intensity modes. Values are exactly those used in the approved A2 mockup. Format follows the W3C Design Tokens draft ($value/$type).",
  "color": {
    "bg": {
      "void":    { "$value": "#02050a", "$type": "color", "$description": "3D scene background and app root" },
      "doc":     { "$value": "#070a0f", "$type": "color", "$description": "Documentation / non-3D pages" },
      "ground":  { "$value": "#02060b", "$type": "color", "$description": "Ground plane below the horizon" },
      "code":    { "$value": "rgba(1,4,9,0.85)", "$type": "color", "$description": "Payload viewer well" },
      "input":   { "$value": "rgba(5,14,24,0.9)", "$type": "color" },
      "row":     { "$value": "rgba(5,14,24,0.6)", "$type": "color", "$description": "Unselected list rows" }
    },
    "panel": {
      "fillCinematic":   { "$value": "rgba(2,7,13,0.70)", "$type": "color" },
      "fillOperational": { "$value": "rgba(2,7,13,0.90)", "$type": "color" },
      "borderCyan":      { "$value": "rgba(86,214,255,0.22)", "$type": "color", "$description": "Explorer, replay bar, camera bar" },
      "borderWhite":     { "$value": "rgba(242,251,255,0.30)", "$type": "color", "$description": "Inspector (the 'evidence' surface)" },
      "divider":         { "$value": "rgba(150,190,230,0.14)", "$type": "color" },
      "control":         { "$value": "rgba(150,190,230,0.25)", "$type": "color", "$description": "Idle button/chip border" }
    },
    "ink": {
      "strong":    { "$value": "#f2fbff", "$type": "color", "$description": "Selected text, big numbers" },
      "primary":   { "$value": "#e9f2fb", "$type": "color" },
      "body":      { "$value": "#d3e1ee", "$type": "color" },
      "secondary": { "$value": "#a9bccd", "$type": "color" },
      "tertiary":  { "$value": "#7d93a8", "$type": "color", "$description": "Captions, section labels. 6.4:1 on bg.void" },
      "muted":     { "$value": "#6f859b", "$type": "color", "$description": "Punctuation, placeholders. Not for body text" },
      "disabled":  { "$value": "#4c5f72", "$type": "color", "$description": "Not-yet-reached rows, breadcrumb separators" }
    },
    "semantic": {
      "request":  { "$value": "#f2fbff", "$type": "color", "$description": "The selected transaction: route, packets, critical path. White-hot." },
      "flow":     { "$value": "#56d6ff", "$type": "color", "$description": "Healthy traffic, idle integrations, primary accent, focus ring" },
      "response": { "$value": "#7fe1ff", "$type": "color", "$description": "Return packets, healthy windows" },
      "degraded": { "$value": "#ffb340", "$type": "color", "$description": "Queues, waiting, degraded, SLO breach numbers, redacted marker" },
      "failure":  { "$value": "#ff6b7d", "$type": "color", "$description": "Errors, timeouts, evicted/cordoned, failed calls" },
      "lineage":  { "$value": "#b69bff", "$type": "color", "$description": "Provenance, training, control-plane arcs" },
      "lineageLight": { "$value": "#cdbaff", "$type": "color" },
      "telemetry":{ "$value": "#8fb3d1", "$type": "color", "$description": "Observability components" }
    },
    "material": {
      "service":  { "edge": "#56d6ff", "top": "#0b1a27", "front": "#050c14", "side": "#08131d", "window": "#7fe1ff" },
      "compute":  { "edge": "#8fdcff", "top": "#0b1a27", "front": "#040a11", "side": "#07111b", "window": "#cfefff" },
      "selected": { "edge": "#f2fbff", "top": "#14202b", "front": "#060c13", "side": "#0a141e", "window": "#ffffff" },
      "failed":   { "edge": "#ff6b7d", "top": "#1a0b0f", "front": "#0c0507", "side": "#12080b", "window": "#ff6b7d" },
      "degraded": { "edge": "#ffb340", "top": "#1f1608", "front": "#0c0904", "side": "#140f06", "window": "#ffc46b" },
      "queue":    { "edge": "#ffb340", "top": "#1a1409", "front": "#0b0905", "side": "#120e07", "window": "#ffc46b" },
      "lineage":  { "edge": "#b69bff", "top": "#130f23", "front": "#080612", "side": "#0d0a19", "window": "#cdbaff" },
      "data":     { "edge": "#b69bff", "top": "#100d1f", "front": "#07060f", "side": "#0b0916", "window": "#a993f0" },
      "telemetry":{ "edge": "#8fb3d1", "top": "#0c141c", "front": "#060a0f", "side": "#091018", "window": "#a9c6de" }
    },
    "code": {
      "key":      { "$value": "#8fb3d1", "$type": "color" },
      "string":   { "$value": "#cfefff", "$type": "color" },
      "number":   { "$value": "#ffffff", "$type": "color" },
      "literal":  { "$value": "#b69bff", "$type": "color", "$description": "true / false / null" },
      "punct":    { "$value": "#6f859b", "$type": "color" },
      "error":    { "$value": "#ff6b7d", "$type": "color", "$description": "Any token matching error codes (DEADLINE_EXCEEDED, 4xx/5xx, DENY, BLOCK…)" },
      "redacted": { "$value": "#ffb340", "$type": "color" }
    },
    "sky": {
      "top":            { "$value": "#010307", "$type": "color" },
      "midCinematic":   { "$value": "#06121d", "$type": "color" },
      "lowCinematic":   { "$value": "#0d2a3d", "$type": "color" },
      "midOperational": { "$value": "#03080e", "$type": "color" },
      "lowOperational": { "$value": "#06121b", "$type": "color" },
      "haze":           { "$value": "#1b4a66", "$type": "color", "$description": "Radial haze, 36% at centre, cinematic only" }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "'Michroma', 'Saira', sans-serif", "$type": "fontFamily", "$description": "Uppercase only. District names, panel titles, concept chips. Never for body text or numbers." },
      "ui":      { "$value": "'Saira', system-ui, sans-serif", "$type": "fontFamily", "$description": "Body, buttons, descriptions. Weights 300–700." },
      "data":    { "$value": "'JetBrains Mono', ui-monospace, monospace", "$type": "fontFamily", "$description": "Every id, number, time, function name, payload, axis label." }
    },
    "source": { "$value": "https://fonts.googleapis.com/css2?family=Michroma&family=Saira:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap", "$type": "other" },
    "size": {
      "micro":    { "$value": "10.5px", "$type": "dimension", "$description": "Badges, payload meta" },
      "caption":  { "$value": "11px",   "$type": "dimension", "$description": "Section labels (mono, 0.16em tracking, uppercase)" },
      "small":    { "$value": "12px",   "$type": "dimension" },
      "body":     { "$value": "13px",   "$type": "dimension" },
      "bodyL":    { "$value": "14px",   "$type": "dimension" },
      "id":       { "$value": "18px",   "$type": "dimension", "$description": "Selected transaction id" },
      "stat":     { "$value": "16px",   "$type": "dimension", "$description": "Stat tiles in the inspector" },
      "time":     { "$value": "18px",   "$type": "dimension", "$description": "Replay clock 't = …'" },
      "title":    { "$value": "15px",   "$type": "dimension", "$description": "Brand wordmark (display, 0.24em)" }
    },
    "tracking": {
      "label":   { "$value": "0.16em", "$type": "other" },
      "display": { "$value": "0.12em", "$type": "other" },
      "brand":   { "$value": "0.24em", "$type": "other" }
    }
  },
  "space": {
    "gutter":   { "$value": "24px", "$type": "dimension", "$description": "Screen edge to panel" },
    "panelPad": { "$value": "16px", "$type": "dimension" },
    "s1": { "$value": "2px", "$type": "dimension" }, "s2": { "$value": "4px", "$type": "dimension" }, "s3": { "$value": "6px", "$type": "dimension" },
    "s4": { "$value": "8px", "$type": "dimension" }, "s5": { "$value": "10px", "$type": "dimension" }, "s6": { "$value": "12px", "$type": "dimension" },
    "s7": { "$value": "14px", "$type": "dimension" }, "s8": { "$value": "18px", "$type": "dimension" }, "s9": { "$value": "24px", "$type": "dimension" }
  },
  "size": {
    "header":        { "$value": "64px",  "$type": "dimension" },
    "explorerWidth": { "$value": "356px", "$type": "dimension" },
    "inspectorWidth":{ "$value": "372px", "$type": "dimension" },
    "replayHeight":  { "$value": "156px", "$type": "dimension" },
    "control":       { "$value": "36px",  "$type": "dimension", "$description": "Camera bar buttons, segmented controls" },
    "controlLarge":  { "$value": "44px",  "$type": "dimension", "$description": "Play button, search input — touch-safe minimum" },
    "chip":          { "$value": "30px",  "$type": "dimension" },
    "row":           { "$value": "26px",  "$type": "dimension", "$description": "Call list rows" }
  },
  "radius": {
    "none": { "$value": "0px", "$type": "dimension", "$description": "Everything. Hard edges are part of the look." },
    "dot":  { "$value": "50%", "$type": "dimension", "$description": "Status dots and pulse rings only" }
  },
  "border": {
    "hairline": { "$value": "1px solid", "$type": "other" },
    "rowAccent":{ "$value": "3px solid (left edge, status color)", "$type": "other" },
    "selected": { "$value": "1px solid rgba(242,251,255,0.6)", "$type": "other" }
  },
  "glow": {
    "blurCinematic":    { "$value": 3.2, "$type": "number", "$description": "Gaussian std-dev, px, for edges/arcs/packets" },
    "blurBigCinematic": { "$value": 9,   "$type": "number", "$description": "Horizon line, packets, beams" },
    "blurOperational":  { "$value": 1.1, "$type": "number" },
    "blurBigOperational": { "$value": 3, "$type": "number" },
    "webglBloom": { "$value": { "cinematic": { "intensity": 1.4, "luminanceThreshold": 0.55, "radius": 0.7 }, "operational": { "intensity": 0.35, "luminanceThreshold": 0.8, "radius": 0.4 } }, "$type": "other", "$description": "Starting values for a WebGL selective bloom pass. Tune to match screenshots." }
  },
  "motion": {
    "easeFlight":  { "$value": "cubic-bezier(0.7, 0, 0.2, 1)", "$type": "cubicBezier" },
    "flight":      { "$value": "1100ms", "$type": "duration", "$description": "Zoom-stop camera flights and label follow" },
    "quick":       { "$value": "300ms",  "$type": "duration", "$description": "Zoom +/- buttons" },
    "orbitStep":   { "$value": "240ms",  "$type": "duration", "$description": "Orbit/tilt buttons: 8 frames × 30 ms, smoothstep" },
    "pulse":       { "$value": "1200ms", "$type": "duration", "$description": "Active building glow" },
    "ring":        { "$value": "1300ms", "$type": "duration", "$description": "Expanding ring at callee, ease-out" },
    "replayTrack": { "$value": "16s",    "$type": "duration", "$description": "Full replay track at 1×" },
    "liveTick":    { "$value": "1000ms", "$type": "duration", "$description": "Live tail refresh" },
    "flowDash":    { "$value": "clamp(1.6s, 9s − 1.6s × log10(ratePerSec), 9s)", "$type": "other", "$description": "Dash cycle for idle arcs: faster = busier" }
  },
  "intensity": {
    "$description": "Operational vs Cinematic changes rendering only. Never values, positions, visibility of data, colors' meaning or labels.",
    "operational": { "bloom": "low", "haze": 0, "vignette": 0, "motes": 0, "beam": 0, "horizonGlow": 0.35, "gridNear": 0.12, "gridFar": 0.04, "panelOpacity": 0.9, "windowBoost": 0.8, "cameraDrift": false },
    "cinematic":   { "bloom": "high", "haze": 1, "vignette": 0.85, "motes": 0.8, "beam": 1, "horizonGlow": 0.9, "gridNear": 0.2, "gridFar": 0.07, "panelOpacity": 0.7, "windowBoost": 1.0, "cameraDrift": "optional, ≤0.5°/s, pauses on interaction" }
  },
  "z": {
    "scene": 0, "sceneOverlay": 10, "labels": 20, "floorPanel": 30, "cameraBar": 40, "panels": 50, "toast": 60
  }
}
